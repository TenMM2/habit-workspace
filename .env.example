# URL del proxy PHP del asistente. Solo hace falta en el móvil (Capacitor); en web y escritorio se deja vacía.
# Ejemplo con el emulador de Android: http://10.0.2.2:8787/gemini.php
VITE_ASSISTANT_URL=

# Copia este archivo como .env y rellena los valores de tu proyecto Firebase
# (Consola Firebase → Configuración del proyecto → Tus apps → App web)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
