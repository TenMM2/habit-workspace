{
  "name": "habit-workspace",
  "productName": "Habit Workspace",
  "private": true,
  "version": "1.0.0",
  "description": "Habit Workspace: plataforma de seguimiento de hábitos con asistente IA (TFG DAW/DAM)",
  "author": "Saúl Lázaro Casterad",
  "license": "UNLICENSED",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "api": "php -c api/php.ini -S localhost:8787 -t api",
    "desktop": "npm run build && node scripts/lanzar-electron.mjs",
    "electron:dev": "node scripts/lanzar-electron.mjs --dev-url=http://localhost:5173",
    "desktop:pack": "npm run build && node scripts/empaquetar.mjs",
    "cap:sync": "npm run build && cap sync",
    "cap:android": "npm run build && cap sync android && cap open android",
    "icons": "node scripts/generar-iconos.mjs",
    "docs:diagramas": "node scripts/exportar-diagramas.mjs",
    "docs:word": "node scripts/exportar-diagramas.mjs && node scripts/exportar-word.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "firebase": "^13.1.0",
    "lucide-react": "^1.61.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@electron/packager": "^20.3.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "electron": "^45.0.0",
    "fake-indexeddb": "^6.2.6",
    "jszip": "^3.10.2",
    "playwright-core": "^1.64.1",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
